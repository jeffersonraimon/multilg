  "config": {
    "hyperglass_like": true,
    "base_url": "https://lg.viams.com.br",
    "location": "cpe01",
    "api_format": "v2",
    "vrf": "default",
    "bootstrap_session": false,
    "timeout": 90,
    "verify_tls": true,
    "query_types": {
