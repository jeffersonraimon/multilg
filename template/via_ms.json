      "bgp": "__hyperglass_huawei_bgp_route__",
      "ping": "__hyperglass_huawei_ping__",
      "bgp_aspath": "__hyperglass_huawei_bgp_aspath__",
      "traceroute": "__hyperglass_huawei_traceroute__"
    }
  }
}