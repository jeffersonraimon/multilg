{
  "name": "LG IX-SP",
  "protocol": "telnet",
  "enabled": true,
  "config": {
    "host": "lg.sp.ptt.br",
    "port": 23,
    "username": "rviews",
    "password": "rviews",
    "username_prompt": "(?i)(login|username)[: ]*$",
    "password_prompt": "(?i)password[: ]*$",
    "prompt_regex": "[>#]\\s*$",
    "pre_commands": [
      "terminal length 0"
    ],
    "commands": {
      "bgp": "show ip bgp {target} longer-prefixes"
    },
    "quit_command": "exit",
    "timeout": 20,
    "commands_v6": {
      "bgp": "show bgp {target} longer-prefixes"
    }
  }
}