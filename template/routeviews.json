{
  "name": "LG RouteViews",
  "protocol": "telnet",
  "enabled": true,
  "config": {
    "host": "route-views.routeviews.org",
    "port": 23,
    "username": "rviews",
    "password": "rviews",
    "username_prompt": "(?i)(login|username)[: ]*$",
    "password_prompt": "(?i)password[: ]*$",
    "prompt_regex": "[>#]\\s*$",
    "pre_commands": [
      "terminal length 0"
    ],
    "commands": {
      "ping": "ping {target}",
      "traceroute": "traceroute {target}",
      "bgp": "show bgp ipv4 unicast {target} longer-prefixes"
    },
    "quit_command": "exit",
    "timeout": 60,
    "commands_v6": {
      "ping": "ping ipv6 {target}",
      "traceroute": "traceroute ipv6 {target}",
      "bgp": "show bgp ipv6 unicast {target} longer-prefixes"
    }
  }
}