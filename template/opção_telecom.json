{
  "name": "LG Opção Telecom",
  "protocol": "http",
  "enabled": true,
  "config": {
    "hyperglass_like": true,
    "base_url": "https://lg.opcaotelecom.com.br",
    "location": "cascavel_pr",
    "api_format": "v2",
    "vrf": "default",
    "bootstrap_session": false,
    "timeout": 90,
    "verify_tls": true,
    "query_types": {
      "bgp": "__hyperglass_juniper_bgp_route_table__",
      "bgp_aspath": "__hyperglass_juniper_bgp_aspath_table__",
      "traceroute": "__hyperglass_juniper_traceroute__",
      "ping": "__hyperglass_juniper_ping__",
      "bgp_community": "__hyperglass_juniper_bgp_community_table__"
    }
  }
}