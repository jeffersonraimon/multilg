{
  "name": "LG AT&T",
  "protocol": "telnet",
  "enabled": true,
  "config": {
    "host": "route-server.ip.att.net",
    "port": 23,
    "username": "rviews",
    "password": "rviews",
    "username_prompt": "(?i)(login|username)[: ]*$",
    "password_prompt": "(?i)password[: ]*$",
    "prompt_regex": "[>#]\\s*$",
    "pre_commands": [
      "set cli screen-length 0"
    ],
    "commands": {
      "ping": "ping {target}",
      "traceroute": "traceroute {target}",
      "bgp": "show route protocol bgp {target}"
    },
    "commands_v6": {},
    "quit_command": "exit",
    "timeout": 20
  }
}